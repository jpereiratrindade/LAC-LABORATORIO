[Unit]
Description=LAC - Laboratorio de continuidade na rede local
Documentation=man:systemd.service(5)
Conflicts=lac.service

[Service]
Type=simple
WorkingDirectory=%h/.local/share/lac
EnvironmentFile=%h/.config/lac/server.env
ExecStart=%h/.local/bin/lac serve --bind 0.0.0.0 --port 8765 --scan-every 180 --db %h/.local/share/lac/lac.db
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
