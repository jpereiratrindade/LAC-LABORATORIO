[Unit]
Description=LAC - Motor Autonomo de Continuidade e Interpretacao Local
Documentation=man:systemd.service(5)
After=lac-lan.service

[Service]
Type=simple
WorkingDirectory=%h/.local/share/lac
ExecStart=%h/.local/share/lac/scripts/lac_continuity_worker.py --db %h/.local/share/lac/lac.db --daemon --interval 5
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
