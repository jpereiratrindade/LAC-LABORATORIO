# Copy settings to ~/.config/lac/server.env (chmod 600). Never commit real credentials.
LAC_SMTP_HOST=smtp.example.invalid
LAC_SMTP_PORT=587
LAC_SMTP_SECURITY=starttls
LAC_SMTP_USER=
LAC_SMTP_PASS=
LAC_SMTP_FROM=
# Optional stricter allowlist; all entries must still belong to @embrapa.br.
# LAC_AUTH_ALLOWED_EMAILS=nome@embrapa.br,outro@embrapa.br
# Use only when serving HTTPS through a trusted gateway:
# LAC_COOKIE_SECURE=1
# Optional service-to-service credential, disabled by default:
# LAC_SERVICE_TOKEN=
